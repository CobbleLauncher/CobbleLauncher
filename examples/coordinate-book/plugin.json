{
  "id": "coordinate-book",
  "name": "Coordinate Book",
  "version": "0.3.0",
  "api_version": "0.2.0",
  "publisher": "CobbleLauncher",
  "capabilities": [
    "report"
  ],
  "interfaces": {
    "provides": [
      {
        "id": "launcher:report",
        "version": "0.2.0"
