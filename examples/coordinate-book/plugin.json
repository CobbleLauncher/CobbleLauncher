            "when": "instance_selected"
          }
        ],
        "workflow": "report"
      }
    ]
  },
  "icon": {
    "file": "icon.png",
    "sha256": "af1701e3778204df983e0c4807e60be700db65b780848ee0aa1f51598ab12ced"
