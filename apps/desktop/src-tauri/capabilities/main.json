{
  "identifier": "main",
  "description": "Main window: game installation, preferences, Java selection and window controls.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-app-info",
    "allow-get-download-settings",
    "allow-set-download-settings",
    "allow-get-java-settings",
    "allow-pick-java-executable",
    "allow-use-automatic-java",
    "allow-list-game-versions",
    "allow-list-games",
    "allow-default-game-directory",
    "allow-pick-game-directory",
    "allow-create-game",
    "allow-retry-game",
    "allow-prepare-game-launch",
    "allow-start-game",
    "allow-list-fabric-versions",
    "allow-list-loader-versions",
    "allow-rename-game",
    "allow-open-game-directory",
    "allow-open-game-log",
    "allow-preview-mrpack",
    "allow-create-mrpack-game",
    "allow-search-game-mods",
    "allow-preview-game-mod-install",
    "allow-install-game-mod-plan",
    "allow-list-game-mods",
    "allow-import-game-mods",
    "allow-set-game-mod-enabled",
    "allow-remove-game-mod",
    "allow-get-offline-profile",
    "allow-save-offline-profile",
    "allow-remove-offline-profile",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging"
  ]
