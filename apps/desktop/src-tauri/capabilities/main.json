{
  "identifier": "main",
  "description": "Local main window: public app information and standard window controls only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-app-info",
    "allow-get-download-settings",
    "allow-set-download-settings",
    "allow-list-game-versions",
    "allow-list-games",
    "allow-default-game-directory",
    "allow-pick-game-directory",
    "allow-create-game",
    "allow-retry-game",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging"
  ]
}
