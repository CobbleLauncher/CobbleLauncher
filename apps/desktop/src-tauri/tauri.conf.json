{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cobble Launcher",
  "version": "0.1.0-beta.3",
  "identifier": "cobble-launcher-dev",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxQ0U2MDMyQTg0NTVFNDgKUldSSVhrV29NbURPOFNlMHBxSlFYOHBuZlRMdG8vWEJBYkwzLzNKWVFKMlA0UTJ4bHhnOGo2anYK",
      "requireSignedVersion": true
    }
  },
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cobble Launcher",
        "width": 1100,
        "height": 760,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": [
        "main",
        "plugin-view"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "fileAssociations": [{ "ext": ["schem"], "name": "Sponge Schematic", "role": "Viewer" }, { "ext": ["litematic"], "name": "Litematica Schematic", "role": "Viewer" }],
    "active": false
  }
}

