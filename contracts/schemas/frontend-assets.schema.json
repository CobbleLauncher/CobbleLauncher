{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hashed frontend asset index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 4,
            "maxLength": 160,
            "pattern": "^ui/[A-Za-z0-9/_.-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4194304
          }
        }
      }
    }
  },
  "$comment": "plugin-api additionally validates safe path components and MIME, case collisions, required entry HTML, byte totals and index serialization budget."
}
