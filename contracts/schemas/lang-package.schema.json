{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.launcher.invalid/lang-package/v1/input.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "protocol", "sourceName", "packFormat", "namespace", "baselineLocale", "targetLocale", "files"],
  "properties": {
    "schemaVersion": { "const": 1 }, "protocol": { "const": "cobble.lang-package@1" },
    "sourceName": { "type": "string", "maxLength": 256 },
    "packFormat": { "type": ["integer", "null"], "minimum": -2147483648, "maximum": 2147483647 },
    "namespace": { "type": ["string", "null"], "maxLength": 64 },
    "baselineLocale": { "type": ["string", "null"], "maxLength": 64 },
    "targetLocale": { "type": "string", "minLength": 1, "maxLength": 64 },
    "files": { "type": "array", "minItems": 1, "maxItems": 2, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "locale", "text"],
      "properties": { "id": { "type": "string", "pattern": "^file-[0-9]{1,2}$" }, "name": { "type": "string", "maxLength": 512 }, "locale": { "type": "string", "minLength": 1, "maxLength": 64 }, "text": { "type": "string", "maxLength": 1048576 } }
    } }
  }
}
