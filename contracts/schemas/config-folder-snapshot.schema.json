{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selected configuration folder snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "files",
    "skipped",
    "truncated"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skipped": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "truncated": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_name",
          "media_type",
          "text"
        ],
        "properties": {
          "relative_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "allOf": [
              {
                "pattern": "^(?!/)[^\\\\:\u0000-\u001f\u007f]+$"
              },
              {
                "not": {
                  "pattern": "(^|/)\\.{1,2}(/|$)|//"
                }
              }
            ]
          },
          "media_type": {
            "enum": [
              "application/json",
              "application/toml",
              "text/x-java-properties",
              "application/yaml",
              "text/plain"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 262144
          }
        }
      }
    }
  },
  "$comment": "UTF-8 byte limits, per-file media/extension match, unique case-folded relative names, 2MiB total text and 4MiB serialized envelope are additionally enforced by plugin-api semantic validation."
}
