{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.launcher.invalid/v1/types.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:\\x00])[^\\r\\n]+$",
      "description": "Structural filter only. docs/10 requires semantic, collision, link and TOCTOU checks."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashes": {
      "type": "object",
      "properties": {
        "sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sha512": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "mojang",
            "fabric",
            "forge",
            "neoforge",
            "modrinth",
            "curseforge",
            "local",
            "plugin"
          ]
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "authorization": {
          "enum": [
            "public",
            "provider_grant",
            "user_local",
            "unavailable"
          ]
        },
        "plugin_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "provider",
        "authorization"
      ],
      "additionalProperties": false
    },
    "loader": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "fabric",
            "forge",
            "neoforge",
            "quilt"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "kind",
        "version"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expected_hashes": {
          "$ref": "#/$defs/hashes"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": [
        "artifact_id",
        "size",
        "expected_hashes",
        "sources"
      ],
      "additionalProperties": false
    },
    "instance": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "instance_id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "minecraft_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "loader": {
          "anyOf": [
            {
              "$ref": "#/$defs/loader"
            },
            {
              "type": "null"
            }
          ]
        },
        "account_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 512,
          "maximum": 1048576
        },
        "active_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "root_handle": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "schema_version",
        "instance_id",
        "name",
        "minecraft_version",
        "loader",
        "account_id",
        "memory_mib",
        "active_revision",
        "root_handle"
      ],
      "additionalProperties": false
    },
    "lockedFile": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "role": {
          "enum": [
            "mod",
            "config",
            "resourcepack",
            "shaderpack",
            "library",
            "asset",
            "client"
          ]
        },
        "origin": {
          "$ref": "#/$defs/source"
        },
        "enabled": {
          "type": "boolean"
        },
        "ownership": {
          "enum": [
            "pack",
            "user"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "size",
        "role",
        "origin",
        "enabled",
        "ownership"
      ],
      "additionalProperties": false
    },
    "lock": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "instance_id": {
          "$ref": "#/$defs/id"
        },
        "revision_id": {
          "$ref": "#/$defs/id"
        },
        "parent_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "minecraft_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "loader": {
          "anyOf": [
            {
              "$ref": "#/$defs/loader"
            },
            {
              "type": "null"
            }
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockedFile"
          },
          "maxItems": 100000
        },
        "pack_baseline_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "instance_id",
        "revision_id",
        "parent_revision",
        "minecraft_version",
        "loader",
        "files",
        "pack_baseline_revision"
      ],
      "additionalProperties": false
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "write"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "artifact_id": {
              "$ref": "#/$defs/id"
            },
            "before_sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "path",
            "artifact_id",
            "before_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "remove"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "before_sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "kind",
            "path",
            "before_sha256"
          ],
          "additionalProperties": false
        }
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "plan_id": {
          "$ref": "#/$defs/id"
        },
        "instance_id": {
          "$ref": "#/$defs/id"
        },
        "base_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_revision": {
          "$ref": "#/$defs/id"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "maxItems": 100000
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          },
          "maxItems": 100000
        },
        "risks": {
          "type": "array",
          "items": {
            "enum": [
              "execute_official_installer",
              "unknown_local_content",
              "user_config_conflict",
              "new_plugin_permission",
              "unverified_distribution"
            ]
          },
          "uniqueItems": true
        },
        "blocked_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 1000
        },
        "approval_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "schema_version",
        "plan_id",
        "instance_id",
        "base_revision",
        "next_revision",
        "artifacts",
        "operations",
        "risks",
        "blocked_reasons",
        "approval_digest"
      ],
      "additionalProperties": false
    },
    "plugin": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "publisher": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "api_version": {
          "const": "1.0"
        },
        "entry": {
          "const": "component.wasm"
        },
        "component_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contributes": {
          "type": "array",
          "items": {
            "enum": [
              "catalog",
              "pack_importer",
              "diagnostic",
              "settings"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "permissions": {
          "type": "object",
          "properties": {
            "https_hosts": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
              },
              "maxItems": 16,
              "uniqueItems": true
            },
            "instance_metadata": {
              "type": "boolean"
            },
            "archive_metadata": {
              "type": "boolean"
            },
            "sanitized_diagnostics": {
              "type": "boolean"
            }
          },
          "required": [
            "https_hosts",
            "instance_metadata",
            "archive_metadata",
            "sanitized_diagnostics"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "id",
        "publisher",
        "name",
        "version",
        "api_version",
        "entry",
        "component_sha256",
        "contributes",
        "permissions"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "waiting_user",
            "blocked_external",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "completed_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "sequence",
        "status",
        "phase",
        "completed_bytes",
        "total_bytes",
        "error_code"
      ],
      "additionalProperties": false
    }
  }
}
